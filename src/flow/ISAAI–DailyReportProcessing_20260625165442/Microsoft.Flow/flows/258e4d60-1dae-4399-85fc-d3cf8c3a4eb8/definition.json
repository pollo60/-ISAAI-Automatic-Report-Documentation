{
  "name": "258e4d60-1dae-4399-85fc-d3cf8c3a4eb8",
  "id": "/providers/Microsoft.Flow/flows/258e4d60-1dae-4399-85fc-d3cf8c3a4eb8",
  "type": "Microsoft.Flow/flows",
  "properties": {
    "apiId": "/providers/Microsoft.PowerApps/apis/shared_logicflows",
    "displayName": "ISAAI – Daily Report Processing",
    "definition": {
      "metadata": {
        "workflowEntityId": null,
        "processAdvisorMetadata": null,
        "flowChargedByPaygo": null,
        "flowclientsuspensionreason": "None",
        "flowclientsuspensiontime": null,
        "flowclientsuspensionreasondetails": null,
        "creator": {
          "id": "",
          "type": "User",
          "tenantId": ""
        },
        "provisioningMethod": "FromDefinition",
        "failureAlertSubscription": true,
        "clientLastModifiedTime": "2026-06-28T21:00:00.0000000Z",
        "creationSource": "Portal",
        "modifiedSources": "Portal"
      },
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "When_a_new_email_arrives_(V3)": {
          "splitOn": "@triggerOutputs()?['body/value']",
          "type": "OpenApiConnectionNotification",
          "inputs": {
            "parameters": {
              "includeAttachments": true,
              "subjectFilter": "Financial Report",
              "fetchOnlyWithAttachment": true,
              "folderPath": "Inbox"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "connectionName": "shared_office365",
              "operationId": "OnNewEmailV3"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Phase_A__Initialize_Variables": {
          "actions": {
            "Initialize_variable_LogItemID": {
              "runAfter": {},
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "LogItemID",
                    "type": "integer"
                  }
                ]
              }
            },
            "Initialize_variable_Report_Date": {
              "runAfter": {
                "Initialize_variable_LogItemID": [
                  "Succeeded"
                ]
              },
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "ReportDate",
                    "type": "string",
                    "value": "@{substring(triggerOutputs()?['body/attachments'][0]['name'], 0, 8)}"
                  }
                ]
              }
            },
            "Initialize_variable_ReportA_Result": {
              "runAfter": {
                "Initialize_variable_Report_Date": [
                  "Succeeded"
                ]
              },
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "ReportA_Result",
                    "type": "string",
                    "value": "Pass"
                  }
                ]
              }
            },
            "Initialize_variable_ReportB_Result": {
              "runAfter": {
                "Initialize_variable_ReportA_Result": [
                  "Succeeded"
                ]
              },
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "ReportB_Result",
                    "type": "string",
                    "value": "Pass"
                  }
                ]
              }
            },
            "Initialize_variable_ReportA_Details": {
              "runAfter": {
                "Initialize_variable_ReportB_Result": [
                  "Succeeded"
                ]
              },
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "ReportA_Details",
                    "type": "string",
                    "value": "No violation detected"
                  }
                ]
              }
            },
            "Initialize_variable_ReportB_Details": {
              "runAfter": {
                "Initialize_variable_ReportA_Details": [
                  "Succeeded"
                ]
              },
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "ReportB_Details",
                    "type": "string",
                    "value": "No violation detected"
                  }
                ]
              }
            }
          },
          "runAfter": {},
          "type": "Scope"
        },
        "Phase_B__Create_SharePoint_Entry": {
          "actions": {
            "Create_item_in_Report_Processing_Log": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "https://studfrauasde.sharepoint.com/sites/ISAAIDailyReportProcessing",
                  "table": "Report Processing Log",
                  "item/Title": "@triggerOutputs()?['body/subject']",
                  "item/ReceivedDateTime": "@triggerOutputs()?['body/receivedDateTime']",
                  "item/SenderEmail": "@triggerOutputs()?['body/from']",
                  "item/ReportDate": "@variables('ReportDate')",
                  "item/OverallStatus": "Processing",
                  "item/ExceptionFlag": "No"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PostItem"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Set_variable_LogItemID": {
              "runAfter": {
                "Create_item_in_Report_Processing_Log": [
                  "Succeeded"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "LogItemID",
                "value": "@outputs('Create_item_in_Report_Processing_Log')?['body/ID']"
              }
            }
          },
          "runAfter": {
            "Phase_A__Initialize_Variables": [
              "Succeeded"
            ]
          },
          "type": "Scope"
        },
        "Phase_C__Extract_ZIP_and_Read_XML": {
          "actions": {
            "Apply_to_each_attachment": {
              "foreach": "@triggerOutputs()?['body/attachments']",
              "actions": {
                "Check_if_attachment_is_ZIP": {
                  "actions": {
                    "Create_ZIP_file_in_OneDrive": {
                      "runAfter": {},
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "folderPath": "/Evidence Archive/Temp",
                          "name": "@items('Apply_to_each_attachment')?['name']",
                          "body": "@base64ToBinary(items('Apply_to_each_attachment')?['contentBytes'])"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness",
                          "connectionName": "shared_onedriveforbusiness",
                          "operationId": "CreateFile"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "Extract_archive_to_folder": {
                      "runAfter": {
                        "Create_ZIP_file_in_OneDrive": [
                          "Succeeded"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "source": "@outputs('Create_ZIP_file_in_OneDrive')?['body/Id']",
                          "destination": "/Evidence Archive/Temp/Extracted",
                          "overwrite": true
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness",
                          "connectionName": "shared_onedriveforbusiness",
                          "operationId": "ExtractFolderV2"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "Get_ReportTypeA_XML_content": {
                      "runAfter": {
                        "Extract_archive_to_folder": [
                          "Succeeded"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "path": "/Evidence Archive/Temp/Extracted/@{variables('ReportDate')}_ReportTypeA.xml"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness",
                          "connectionName": "shared_onedriveforbusiness",
                          "operationId": "GetFileContent"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "Compose_XML_A_Content": {
                      "runAfter": {
                        "Get_ReportTypeA_XML_content": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": "@body('Get_ReportTypeA_XML_content')"
                    },
                    "Get_ReportTypeB_XML_content": {
                      "runAfter": {
                        "Extract_archive_to_folder": [
                          "Succeeded"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "path": "/Evidence Archive/Temp/Extracted/@{variables('ReportDate')}_ReportTypeB.xml"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness",
                          "connectionName": "shared_onedriveforbusiness",
                          "operationId": "GetFileContent"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "Compose_XML_B_Content": {
                      "runAfter": {
                        "Get_ReportTypeB_XML_content": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": "@body('Get_ReportTypeB_XML_content')"
                    }
                  },
                  "runAfter": {},
                  "expression": {
                    "and": [
                      {
                        "endsWith": [
                          "@items('Apply_to_each_attachment')?['name']",
                          ".zip"
                        ]
                      }
                    ]
                  },
                  "type": "If"
                }
              },
              "runAfter": {},
              "type": "Foreach"
            }
          },
          "runAfter": {
            "Phase_B__Create_SharePoint_Entry": [
              "Succeeded"
            ]
          },
          "type": "Scope"
        },
        "Phase_D__Read_Report_Status": {
          "actions": {
            "Read_ReportA_Status": {
              "actions": {
                "Compose_StatusA": {
                  "runAfter": {},
                  "type": "Compose",
                  "inputs": "@xpath(xml(outputs('Compose_XML_A_Content')), 'string(/XetraReport/Summary/OverallStatus)')"
                },
                "Compose_ViolationsA": {
                  "runAfter": {},
                  "type": "Compose",
                  "inputs": "@xpath(xml(outputs('Compose_XML_A_Content')), 'string(/XetraReport/Summary/ViolationsFound)')"
                },
                "Check_ReportA_has_Violations": {
                  "actions": {
                    "Set_ReportA_Violation": {
                      "runAfter": {},
                      "type": "SetVariable",
                      "inputs": {
                        "name": "ReportA_Result",
                        "value": "Violation"
                      }
                    },
                    "Set_ReportA_Details": {
                      "runAfter": {
                        "Set_ReportA_Violation": [
                          "Succeeded"
                        ]
                      },
                      "type": "SetVariable",
                      "inputs": {
                        "name": "ReportA_Details",
                        "value": "@{outputs('Compose_ViolationsA')} trade violation(s) flagged in daily Xetra report"
                      }
                    }
                  },
                  "runAfter": {
                    "Compose_StatusA": [
                      "Succeeded"
                    ],
                    "Compose_ViolationsA": [
                      "Succeeded"
                    ]
                  },
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@outputs('Compose_StatusA')",
                          "Violation"
                        ]
                      }
                    ]
                  },
                  "type": "If"
                }
              },
              "runAfter": {},
              "type": "Scope"
            },
            "Read_ReportB_Status": {
              "actions": {
                "Compose_StatusB": {
                  "runAfter": {},
                  "type": "Compose",
                  "inputs": "@xpath(xml(outputs('Compose_XML_B_Content')), 'string(/XetraReport/Summary/OverallStatus)')"
                },
                "Compose_ViolationsB": {
                  "runAfter": {},
                  "type": "Compose",
                  "inputs": "@xpath(xml(outputs('Compose_XML_B_Content')), 'string(/XetraReport/Summary/ViolationsFound)')"
                },
                "Check_ReportB_has_Violations": {
                  "actions": {
                    "Set_ReportB_Violation": {
                      "runAfter": {},
                      "type": "SetVariable",
                      "inputs": {
                        "name": "ReportB_Result",
                        "value": "Violation"
                      }
                    },
                    "Set_ReportB_Details": {
                      "runAfter": {
                        "Set_ReportB_Violation": [
                          "Succeeded"
                        ]
                      },
                      "type": "SetVariable",
                      "inputs": {
                        "name": "ReportB_Details",
                        "value": "@{outputs('Compose_ViolationsB')} trader violation(s) flagged in monthly Xetra summary"
                      }
                    }
                  },
                  "runAfter": {
                    "Compose_StatusB": [
                      "Succeeded"
                    ],
                    "Compose_ViolationsB": [
                      "Succeeded"
                    ]
                  },
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@outputs('Compose_StatusB')",
                          "Violation"
                        ]
                      }
                    ]
                  },
                  "type": "If"
                }
              },
              "runAfter": {},
              "type": "Scope"
            }
          },
          "runAfter": {
            "Phase_C__Extract_ZIP_and_Read_XML": [
              "Succeeded"
            ]
          },
          "type": "Scope"
        },
        "Phase_E__Evidence_Storage": {
          "actions": {
            "Save_ReportA_XML_as_XLSX_to_SharePoint": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "https://studfrauasde.sharepoint.com/sites/ISAAIDailyReportProcessing",
                  "folderPath": "/Evidence Archive/Evidence",
                  "name": "@{variables('ReportDate')}_ReportTypeA.xlsx",
                  "body": "@{outputs('Compose_XML_A_Content')}"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "CreateFile"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Save_ReportB_XML_as_XLSX_to_SharePoint": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "https://studfrauasde.sharepoint.com/sites/ISAAIDailyReportProcessing",
                  "folderPath": "/Evidence Archive/Evidence",
                  "name": "@{variables('ReportDate')}_ReportTypeB.xlsx",
                  "body": "@{outputs('Compose_XML_B_Content')}"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "CreateFile"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Copy_original_XML_ReportA_to_archive": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "https://studfrauasde.sharepoint.com/sites/ISAAIDailyReportProcessing",
                  "source": "/Evidence Archive/Temp/Extracted/@{variables('ReportDate')}_ReportTypeA.xml",
                  "destination": "/Evidence Archive/XML Archive/@{variables('ReportDate')}_ReportTypeA.xml",
                  "overwrite": true
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "CopyFile"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Copy_original_XML_ReportB_to_archive": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "https://studfrauasde.sharepoint.com/sites/ISAAIDailyReportProcessing",
                  "source": "/Evidence Archive/Temp/Extracted/@{variables('ReportDate')}_ReportTypeB.xml",
                  "destination": "/Evidence Archive/XML Archive/@{variables('ReportDate')}_ReportTypeB.xml",
                  "overwrite": true
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "CopyFile"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "runAfter": {
            "Phase_D__Read_Report_Status": [
              "Succeeded"
            ]
          },
          "type": "Scope"
        },
        "Phase_F__Exception_Gate_and_Completion": {
          "actions": {
            "Check_for_violations": {
              "actions": {
                "Update_SharePoint_Exception": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "dataset": "https://studfrauasde.sharepoint.com/sites/ISAAIDailyReportProcessing",
                      "table": "Report Processing Log",
                      "id": "@variables('LogItemID')",
                      "item/ReportA_Status": "@variables('ReportA_Result')",
                      "item/ReportB_Status": "@variables('ReportB_Result')",
                      "item/ReportA_ViolationDetails": "@variables('ReportA_Details')",
                      "item/ReportB_ViolationDetails": "@variables('ReportB_Details')",
                      "item/OverallStatus": "Exception",
                      "item/ExceptionFlag": "Yes",
                      "item/EvidenceA_Link": "https://studfrauasde.sharepoint.com/sites/ISAAIDailyReportProcessing/Evidence%20Archive/Evidence/@{variables('ReportDate')}_ReportTypeA.xlsx",
                      "item/EvidenceB_Link": "https://studfrauasde.sharepoint.com/sites/ISAAIDailyReportProcessing/Evidence%20Archive/Evidence/@{variables('ReportDate')}_ReportTypeB.xlsx"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Send_exception_email_to_supervisor": {
                  "runAfter": {
                    "Update_SharePoint_Exception": [
                      "Succeeded"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "emailMessage/To": "supervisor@example.com",
                      "emailMessage/Subject": "⚠️ ISAAI Exception — @{variables('ReportDate')} Report Validation Failed",
                      "emailMessage/Body": "<h2>Exception Alert — Daily Report Validation</h2><p><strong>Report Date:</strong> @{variables('ReportDate')}</p><p><strong>Report A Status:</strong> @{variables('ReportA_Result')}</p><p><strong>Report A Details:</strong> @{variables('ReportA_Details')}</p><p><strong>Report B Status:</strong> @{variables('ReportB_Result')}</p><p><strong>Report B Details:</strong> @{variables('ReportB_Details')}</p><p>Please review the evidence files and presentation in the <a href=\"https://studfrauasde.sharepoint.com/sites/ISAAIDailyReportProcessing/Evidence%20Archive\">Evidence Archive</a>.</p>",
                      "emailMessage/Importance": "High",
                      "emailMessage/IsHtml": true
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                      "connectionName": "shared_office365",
                      "operationId": "SendEmailV2"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              },
              "else": {
                "actions": {
                  "Update_SharePoint_Completed": {
                    "runAfter": {},
                    "type": "OpenApiConnection",
                    "inputs": {
                      "parameters": {
                        "dataset": "https://studfrauasde.sharepoint.com/sites/ISAAIDailyReportProcessing",
                        "table": "Report Processing Log",
                        "id": "@variables('LogItemID')",
                        "item/ReportA_Status": "@variables('ReportA_Result')",
                        "item/ReportB_Status": "@variables('ReportB_Result')",
                        "item/ReportA_ViolationDetails": "@variables('ReportA_Details')",
                        "item/ReportB_ViolationDetails": "@variables('ReportB_Details')",
                        "item/OverallStatus": "Completed",
                        "item/ExceptionFlag": "No",
                        "item/EvidenceA_Link": "https://studfrauasde.sharepoint.com/sites/ISAAIDailyReportProcessing/Evidence%20Archive/Evidence/@{variables('ReportDate')}_ReportTypeA.xlsx",
                        "item/EvidenceB_Link": "https://studfrauasde.sharepoint.com/sites/ISAAIDailyReportProcessing/Evidence%20Archive/Evidence/@{variables('ReportDate')}_ReportTypeB.xlsx"
                      },
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                        "connectionName": "shared_sharepointonline",
                        "operationId": "PatchItem"
                      },
                      "authentication": "@parameters('$authentication')"
                    }
                  },
                  "Send_completion_email": {
                    "runAfter": {
                      "Update_SharePoint_Completed": [
                        "Succeeded"
                      ]
                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "parameters": {
                        "emailMessage/To": "team@example.com",
                        "emailMessage/Subject": "✅ ISAAI Completed — @{variables('ReportDate')} Report Validation Passed",
                        "emailMessage/Body": "<h2>Daily Report Validation Passed</h2><p><strong>Report Date:</strong> @{variables('ReportDate')}</p><p><strong>Report A Status:</strong> @{variables('ReportA_Result')}</p><p><strong>Report B Status:</strong> @{variables('ReportB_Result')}</p><p>Evidence files and presentation have been archived in the <a href=\"https://studfrauasde.sharepoint.com/sites/ISAAIDailyReportProcessing/Evidence%20Archive\">Evidence Archive</a>.</p>",
                        "emailMessage/Importance": "Normal",
                        "emailMessage/IsHtml": true
                      },
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                        "connectionName": "shared_office365",
                        "operationId": "SendEmailV2"
                      },
                      "authentication": "@parameters('$authentication')"
                    }
                  }
                }
              },
              "runAfter": {},
              "expression": {
                "or": [
                  {
                    "equals": [
                      "@variables('ReportA_Result')",
                      "Violation"
                    ]
                  },
                  {
                    "equals": [
                      "@variables('ReportB_Result')",
                      "Violation"
                    ]
                  }
                ]
              },
              "type": "If"
            }
          },
          "runAfter": {
            "Phase_E__Evidence_Storage": [
              "Succeeded"
            ]
          },
          "type": "Scope"
        }
      },
      "outputs": {}
    },
    "connectionReferences": {
      "shared_office365": {
        "connectionName": "",
        "source": "Invoker",
        "id": "/providers/Microsoft.PowerApps/apis/shared_office365",
        "tier": "NotSpecified",
        "apiName": "office365"
      },
      "shared_sharepointonline": {
        "connectionName": "",
        "source": "Invoker",
        "id": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
        "tier": "NotSpecified",
        "apiName": "sharepointonline"
      },
      "shared_onedriveforbusiness": {
        "connectionName": "",
        "source": "Invoker",
        "id": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness",
        "tier": "NotSpecified",
        "apiName": "onedriveforbusiness"
      }
    },
    "flowFailureAlertSubscribed": true,
    "isManaged": false
  }
}