      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_ArchiveDMS_di" bpmnElement="Activity_ArchiveDMS">
        <dc:Bounds x="1810" y="450" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_SignOffDMS_di" bpmnElement="Activity_SignOffDMS">
        <dc:Bounds x="2060" y="450" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PM300Exceptions_di" bpmnElement="Gateway_PM300Exceptions" isMarkerVisible="true">
        <dc:Bounds x="660" y="520" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="660" y="579.5" width="50" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InvestigatePM300_di" bpmnElement="Task_InvestigatePM300">
        <dc:Bounds x="780" y="505" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_14g0pvm" bpmnElement="DataStoreReference_0omtpm1">
