<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_DailyFinancialReportValidation_Lanes" targetNamespace="http://example.com/bpmn/daily-financial-report-validation" exporter="Camunda Modeler" exporterVersion="5.45.0">
  <bpmn:collaboration id="Collaboration_DailyFinancialReportValidation">
    <bpmn:participant id="Participant_Process" name="Daily Financial Report Validation Process" processRef="Process_DailyFinancialReportValidation" />
  </bpmn:collaboration>
  <bpmn:process id="Process_DailyFinancialReportValidation" name="Daily Financial Report Validation Process" isExecutable="false">
    <bpmn:documentation>
      Manual daily process for validating Financial Reports PM100 and PM300. Both reports are equivalent and are processed one after the other in any order. The goal is to send one English summary email with both generated Excel tables attached and then store evidence in SharePoint and DMS.
    </bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Main">
      <bpmn:lane id="Lane_EmailSystem" name="Email System">
        <bpmn:flowNodeRef>StartEvent_EmailReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0o1luh6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0jv8y35</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OperationsAnalyst" name="Operations Analyst (Excel)">
        <bpmn:flowNodeRef>Task_ReceiveAndUnzipReports</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SplitParallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PM100Exceptions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InvestigatePM100</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessPM100</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessPM300</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SaveRenamedEvidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareAndSendEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SaveSentEmailSharePoint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ArchiveDMS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_SignOffDMS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PM300Exceptions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InvestigatePM300</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergePM300</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinParallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_1saccrv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0z97zql</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SharePoint" name="SharePoint">
        <bpmn:flowNodeRef>Activity_SaveEmailSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_SaveEvidenceSP</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DMS" name="DMS System">
        <bpmn:flowNodeRef>Activity_CloseAccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_EmailReceived" name="Financial Report email received (11:05)">
      <bpmn:outgoing>Flow_Start_Unzip</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Email" />
    </bpmn:startEvent>
    <bpmn:manualTask id="Task_ReceiveAndUnzipReports" name="Receive ZIP XML, unzip locally, move to desktop">
      <bpmn:incoming>Flow_Start_Unzip</bpmn:incoming>
      <bpmn:outgoing>Flow_Unzip_Split</bpmn:outgoing>
      <bpmn:property id="Property_0k74ur5" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_0gp8x8v">
        <bpmn:sourceRef>DataObject_ZippedXMLReports</bpmn:sourceRef>
        <bpmn:targetRef>Property_0k74ur5</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="DataInputAssociation_1ykawfj">
        <bpmn:sourceRef>DataObjectReference_1h34h3l</bpmn:sourceRef>
        <bpmn:targetRef>Property_0k74ur5</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:parallelGateway id="Gateway_SplitParallel" name="Process both Files independently">
      <bpmn:incoming>Flow_Unzip_Split</bpmn:incoming>
      <bpmn:outgoing>Flow_Split_PM300</bpmn:outgoing>
      <bpmn:outgoing>Flow_Split_PM100</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Activity_SaveEmailSP" name="Saving data">
      <bpmn:incoming>Flow_SaveSP2_SP2Task</bpmn:incoming>
      <bpmn:outgoing>Flow_SP2_ArchiveDMS</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1x7whbr">
        <bpmn:targetRef>DataStore_SharePoint</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_CloseAccess" name="Closing editing access">
      <bpmn:incoming>Flow_SignOff_Close</bpmn:incoming>
      <bpmn:outgoing>Flow_Close_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Completed" name="Daily processing completed">
      <bpmn:incoming>Flow_Close_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Unzip" sourceRef="StartEvent_EmailReceived" targetRef="Task_ReceiveAndUnzipReports" />
    <bpmn:sequenceFlow id="Flow_Unzip_Split" sourceRef="Task_ReceiveAndUnzipReports" targetRef="Gateway_SplitParallel" />
    <bpmn:sequenceFlow id="Flow_Split_PM300" sourceRef="Gateway_SplitParallel" targetRef="Task_ProcessPM300" />
    <bpmn:sequenceFlow id="Flow_PM300_Gateway" sourceRef="Task_ProcessPM300" targetRef="Gateway_PM300Exceptions" />
    <bpmn:sequenceFlow id="Flow_Join_Rename" sourceRef="Gateway_JoinParallel" targetRef="Task_SaveRenamedEvidence" />
    <bpmn:sequenceFlow id="Flow_Rename_SP1" sourceRef="Task_SaveRenamedEvidence" targetRef="Activity_SaveEvidenceSP" />
    <bpmn:sequenceFlow id="Flow_SP1_EmailPrep" sourceRef="Activity_SaveEvidenceSP" targetRef="Task_PrepareAndSendEmail" />
    <bpmn:sequenceFlow id="Flow_SaveSP2_SP2Task" sourceRef="Task_SaveSentEmailSharePoint" targetRef="Activity_SaveEmailSP" />
    <bpmn:sequenceFlow id="Flow_SP2_ArchiveDMS" sourceRef="Activity_SaveEmailSP" targetRef="Activity_ArchiveDMS" />
    <bpmn:sequenceFlow id="Flow_SignOff_Close" sourceRef="Activity_SignOffDMS" targetRef="Activity_CloseAccess" />
    <bpmn:sequenceFlow id="Flow_Close_End" sourceRef="Activity_CloseAccess" targetRef="EndEvent_Completed" />
    <bpmn:dataObjectReference id="DataObject_ZippedXMLReports" name="ZIP XML Financial Report A" dataObjectRef="DataObject_0uqfsmd" />
    <bpmn:dataObject id="DataObject_0uqfsmd" />
    <bpmn:dataObjectReference id="DataObjectReference_1h34h3l" name="ZIP XML Financial Report B" dataObjectRef="DataObject_0op8q9c" />
    <bpmn:dataObject id="DataObject_0op8q9c" />
    <bpmn:serviceTask id="Activity_SaveEvidenceSP" name="Saving data">
      <bpmn:incoming>Flow_Rename_SP1</bpmn:incoming>
      <bpmn:outgoing>Flow_SP1_EmailPrep</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_197ae70">
        <bpmn:targetRef>DataStore_SharePoint</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_PM100_Gateway" sourceRef="Task_ProcessPM100" targetRef="Gateway_PM100Exceptions" />
    <bpmn:sequenceFlow id="Flow_Split_PM100" sourceRef="Gateway_SplitParallel" targetRef="Task_ProcessPM100" />
    <bpmn:sequenceFlow id="Flow_Merge300_Join" sourceRef="Gateway_MergePM300" targetRef="Gateway_JoinParallel" />
    <bpmn:sequenceFlow id="Flow_PM300_Yes" name="yes" sourceRef="Gateway_PM300Exceptions" targetRef="Task_InvestigatePM300" />
    <bpmn:sequenceFlow id="Flow_PM100_Yes" name="yes" sourceRef="Gateway_PM100Exceptions" targetRef="Task_InvestigatePM100" />
    <bpmn:manualTask id="Task_InvestigatePM100" name="Investigate report A Exception">
      <bpmn:incoming>Flow_PM100_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_0qxubgj</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_PM100Exceptions" name="Violation apparent?">
      <bpmn:incoming>Flow_PM100_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_PM100_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_0sy7gsy</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Task_ProcessPM100" name="Process report A (Check DayViol)">
      <bpmn:incoming>Flow_Split_PM100</bpmn:incoming>
      <bpmn:outgoing>Flow_PM100_Gateway</bpmn:outgoing>
      <bpmn:manualTask id="Activity_18rjq1p" name="Import financial report A XML into Excel and check DayViol for Violation">
        <bpmn:documentation>Import the PM100 XML file into Excel using drag and drop. Identify relevant columns. Check that DayViol contains no V in the three relevant rows. If V appears, check the specified values and verify whether the value is below 90.</bpmn:documentation>
      </bpmn:manualTask>
    </bpmn:subProcess>
    <bpmn:subProcess id="Task_ProcessPM300" name="Process report B (Check MonthViol)">
      <bpmn:incoming>Flow_Split_PM300</bpmn:incoming>
      <bpmn:outgoing>Flow_PM300_Gateway</bpmn:outgoing>
      <bpmn:manualTask id="Activity_0o9t890" name="Import financial report B XML into Excel and check MonthViol for Violation">
        <bpmn:documentation>Import the PM300 XML file into Excel using drag and drop. Identify relevant columns. Check that MonthViol contains no V in the three relevant rows. If V appears, check the specified values and verify whether the value is below 90.</bpmn:documentation>
      </bpmn:manualTask>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_1qsmg5w" sourceRef="Task_PrepareAndSendEmail" targetRef="Event_0o1luh6" />
    <bpmn:intermediateThrowEvent id="Event_0o1luh6" name="Report Exception via E-Mail">
      <bpmn:incoming>Flow_1qsmg5w</bpmn:incoming>
      <bpmn:outgoing>Flow_EmailPrep_Deliver</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0u6xziy" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_EmailPrep_Deliver" sourceRef="Event_0o1luh6" targetRef="Task_SaveSentEmailSharePoint" />
    <bpmn:sequenceFlow id="Flow_1h0bdw4" sourceRef="Activity_ArchiveDMS" targetRef="Activity_SignOffDMS" />
    <bpmn:dataStoreReference id="DataStore_SharePoint" name="SharePoint evidence storage" />
    <bpmn:manualTask id="Task_SaveRenamedEvidence" name="Save report A and B evidence in SharePoint">
      <bpmn:incoming>Flow_Join_Rename</bpmn:incoming>
      <bpmn:outgoing>Flow_Rename_SP1</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Task_PrepareAndSendEmail" name="Prepare summary email, attach Excel Files, and send">
      <bpmn:incoming>Flow_SP1_EmailPrep</bpmn:incoming>
      <bpmn:outgoing>Flow_1qsmg5w</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Task_SaveSentEmailSharePoint" name="Save sent email to SharePoint">
      <bpmn:incoming>Flow_EmailPrep_Deliver</bpmn:incoming>
      <bpmn:outgoing>Flow_SaveSP2_SP2Task</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Activity_ArchiveDMS" name="Upload sent email to DMS">
      <bpmn:incoming>Flow_SP2_ArchiveDMS</bpmn:incoming>
      <bpmn:incoming>Flow_1hc6iq1</bpmn:incoming>
      <bpmn:outgoing>Flow_1h0bdw4</bpmn:outgoing>
      <bpmn:outgoing>Flow_0dzf6l1</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_11xwm0o">
        <bpmn:targetRef>DataStoreReference_0omtpm1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="Activity_SignOffDMS" name="Final DMS sign-off">
      <bpmn:incoming>Flow_1h0bdw4</bpmn:incoming>
      <bpmn:incoming>Flow_0dzf6l1</bpmn:incoming>
      <bpmn:outgoing>Flow_SignOff_Close</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="Flow_0sy7gsy" name="no" sourceRef="Gateway_PM100Exceptions" targetRef="Gateway_MergePM300" />
    <bpmn:exclusiveGateway id="Gateway_PM300Exceptions" name="Violation apparent?">
      <bpmn:incoming>Flow_PM300_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_PM300_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_0xiwnef</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0xiwnef" sourceRef="Gateway_PM300Exceptions" targetRef="Gateway_MergePM300" />
    <bpmn:manualTask id="Task_InvestigatePM300" name="Investigate report B Exception">
      <bpmn:incoming>Flow_PM300_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_0ccdt3j</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:dataStoreReference id="DataStoreReference_0omtpm1" name="Company-wide evidence storage" />
    <bpmn:sequenceFlow id="Flow_0dzf6l1" sourceRef="Activity_ArchiveDMS" targetRef="Activity_SignOffDMS" />
    <bpmn:exclusiveGateway id="Gateway_MergePM300">
      <bpmn:incoming>Flow_0sy7gsy</bpmn:incoming>
      <bpmn:incoming>Flow_0xiwnef</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge300_Join</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_JoinParallel" name="Both processed">
      <bpmn:incoming>Flow_Merge300_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Rename</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="Event_1saccrv">
      <bpmn:incoming>Flow_0qxubgj</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0qxubgj" sourceRef="Task_InvestigatePM100" targetRef="Event_1saccrv" />
    <bpmn:endEvent id="Event_0z97zql">
      <bpmn:incoming>Flow_0ccdt3j</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0ccdt3j" sourceRef="Task_InvestigatePM300" targetRef="Event_0z97zql" />
    <bpmn:intermediateThrowEvent id="Event_0jv8y35" name="Market opening message">
      <bpmn:outgoing>Flow_1hc6iq1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0nexad0" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_1hc6iq1" sourceRef="Event_0jv8y35" targetRef="Activity_ArchiveDMS" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_DailyFinancialReportValidation">
    <bpmndi:BPMNPlane id="BPMNPlane_DailyFinancialReportValidation" bpmnElement="Collaboration_DailyFinancialReportValidation">
