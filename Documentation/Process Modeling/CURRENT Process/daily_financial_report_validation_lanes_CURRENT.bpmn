        <dc:Bounds x="1395" y="725" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1378" y="775" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SaveRenamedEvidence_di" bpmnElement="Task_SaveRenamedEvidence">
        <dc:Bounds x="1180" y="450" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
