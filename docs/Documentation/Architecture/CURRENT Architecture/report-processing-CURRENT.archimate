<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="Report Processing IST" id="id-report-ist-model" version="5.0.0">
  <folder name="Strategy" id="id-ist-folder-strategy" type="strategy"/>
  <folder name="Business" id="id-ist-folder-business" type="business">
    <element xsi:type="archimate:BusinessActor" name="Operations Analyst" id="BA_ANALYST">
      <documentation>Performs the complete daily report control manually in the current BAU process.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Manual Daily Report Processing" id="BP_MANUAL_DAILY">
      <documentation>Manual end-to-end daily execution from report receipt to DMS sign-off.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Receive Daily Report Mail" id="BP_RECEIVE">
      <documentation>Receives the daily ZIP/XML reports in the mailbox at the agreed processing time.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Extract ZIP Attachments" id="BP_EXTRACT">
      <documentation>Downloads and extracts the ZIP attachments to the local desktop.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Import XML into Excel" id="BP_IMPORT">
      <documentation>Imports each XML report into Excel to create a readable worksheet.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Validate Report Rules" id="BP_VALIDATE">
      <documentation>Performs a two-step manual validation for each report type. Step 1: checks the primary violation marker column for the value &quot;V&quot;. Step 2: if a violation is found, verifies that the four designated secondary threshold columns all meet the defined minimum threshold; if any fall below the limit, the case is escalated to the supervisor. Applied independently for Report Type A (daily) and Report Type B (month-to-date).</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Store Evidence in SharePoint" id="BP_EVIDENCE">
      <documentation>Stores renamed evidence files in SharePoint with the previous business date.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Compose Summary Email" id="BP_SUMMARY">
      <documentation>Writes the No Exceptions summary, attaches reports, and sends the mail to the fixed distribution list.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Archive Email in DMS" id="BP_ARCHIVE">
      <documentation>Uploads the sent email to the DMS day record and adds the comment.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Sign-off Day Record" id="BP_SIGNOFF">
      <documentation>Performs the irreversible daily sign-off in the DMS user interface.</documentation>
    </element>
  </folder>
  <folder name="Application" id="id-ist-folder-application" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="Outlook Desktop Client" id="AC_OUTLOOK">
      <documentation>Used to receive the incoming ZIP/XML mail and send the final summary email.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Local File Explorer" id="AC_FILES">
      <documentation>Used to download, extract, and manage the report files on the workstation.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Microsoft Excel" id="AC_EXCEL">
      <documentation>Used to transform XML into readable tables and perform the manual inspection.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="SharePoint Workspace" id="AC_SHAREPOINT_WORKSPACE">
      <documentation>Used to upload evidence files and store the sent mail record.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="SharePoint Repository" id="AC_SHAREPOINT_REPO">
      <documentation>Target repository for evidence files and archived outbound mail records.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="DMS Web Portal" id="AC_DMS_PORTAL">
      <documentation>User interface for email upload, commenting, and final daily sign-off.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Corporate Mail Service" id="AC_MAIL_SERVICE">
      <documentation>Provides the inbox and outbound delivery channel used by the manual process.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Inbound ZIP Package" id="DO_ZIP_PACKAGE">
      <documentation>Email attachment package containing the daily report XML files.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Report Type A XML File" id="DO_REPORT_A_XML">
      <documentation>Daily snapshot report covering the previous business day. Received as an XML file in the inbound ZIP package. File naming convention: YYYYMMDD_ReportTypeA. Validated manually using the two-step violation marker and threshold check procedure.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Report Type B XML File" id="DO_REPORT_B_XML">
      <documentation>Month-to-date cumulative report covering the current calendar month. Received as an XML file alongside Report Type A. File naming convention: YYYYMMDD_ReportTypeB. Validated manually using the two-step violation marker and threshold check procedure.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Excel Working Sheet" id="DO_EXCEL_WORKBOOK">
      <documentation>Readable workbook created from XML import and used for manual validation.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Report Type A Evidence File" id="DO_EVIDENCE_A_FILE">
      <documentation>Renamed report type A evidence file stored in SharePoint.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Report Type B Evidence File" id="DO_EVIDENCE_B_FILE">
      <documentation>Renamed report type B evidence file stored in SharePoint.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Summary Email" id="DO_SUMMARY_EMAIL">
      <documentation>Outbound summary message with No Exceptions text and attached evidence.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="DMS Day Record" id="DO_DMS_RECORD">
      <documentation>Archived day entry in the DMS including uploaded mail and final sign-off status.</documentation>
    </element>
  </folder>
  <folder name="Technology &amp; Physical" id="id-ist-folder-technology" type="technology">
    <element xsi:type="archimate:Node" name="Employee Workstation" id="ND_WORKSTATION">
      <documentation>Local user workstation used for the full manual process.</documentation>
    </element>
    <element xsi:type="archimate:Artifact" name="Office Desktop Suite" id="AR_OFFICE_SUITE">
      <documentation>Installed desktop software package providing Outlook and Excel.</documentation>
    </element>
    <element xsi:type="archimate:Artifact" name="Browser Runtime" id="AR_BROWSER_RUNTIME">
      <documentation>Installed browser environment used for SharePoint and DMS interaction.</documentation>
    </element>
    <element xsi:type="archimate:Artifact" name="Local Desktop Workspace" id="AR_LOCAL_DESKTOP">
      <documentation>Local file workspace used to store and manipulate downloaded ZIP and XML files.</documentation>
    </element>
  </folder>
  <folder name="Motivation" id="id-ist-folder-motivation" type="motivation"/>
  <folder name="Implementation &amp; Migration" id="id-ist-folder-implementation" type="implementation_migration"/>
  <folder name="Other" id="id-ist-folder-other" type="other"/>
