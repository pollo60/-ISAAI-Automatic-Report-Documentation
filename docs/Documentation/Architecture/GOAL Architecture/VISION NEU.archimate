<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="Report Processing SOLL" id="id-report-soll-model" version="5.0.0">
  <folder name="Strategy" id="id-soll-folder-strategy" type="strategy"/>
  <folder name="Business" id="id-soll-folder-business" type="business">
    <element xsi:type="archimate:BusinessActor" name="Operations Supervisor" id="BA_SUPERVISOR">
      <documentation>Monitors exceptions, validates edge cases, and performs governance-only intervention in the automated target state.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Automated Daily Report Processing" id="BP_AUTO">
      <documentation>Fully automated daily processing of two structured report types from inbound XML to evidence storage, email distribution, DMS archive, and sign-off.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Exception Review &amp; Governance" id="BP_EXCEPTION">
      <documentation>Human oversight process used only when validation detects a rule breach or automation fault.</documentation>
    </element>
  </folder>
  <folder name="Application" id="id-soll-folder-application" type="application">
    <element xsi:type="archimate:ApplicationService" name="Automated Reporting Service" id="AS_AUTOREPORT">
      <documentation>End-to-end automation service replacing manual XML import, checking, evidence handling, and summary drafting.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Exception Alerting Service" id="AS_EXCEPTION">
      <documentation>Service that routes exceptions and automation failures to the supervisor.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Automation Scheduler" id="AC_SCHEDULER">
      <documentation>Daily trigger component that starts the report-processing workflow at the defined execution time.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Python Automation Engine" id="AC_AUTOMATION">
      <documentation>Core orchestration component coordinating parsing, validation, reporting, delivery, and archival steps.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Mail Attachment Ingestion" id="AC_INGEST">
      <documentation>Retrieves daily ZIP/XML attachments from the inbound mailbox and prepares them for automated processing.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Report Validation Rule Evaluator" id="AC_RULES">
      <documentation>Implements the two-step validation logic for each report type. Step 1: evaluates the primary violation marker column for the value &quot;V&quot;. Step 2: if a violation is detected, checks the four designated secondary threshold columns against the defined minimum limit. Applied independently for Report Type A (daily snapshot) and Report Type B (month-to-date cumulative). Produces a structured validation result per report type consumed by the downstream exception and reporting modules.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Evidence &amp; Report Generator" id="AC_REPORT">
      <documentation>Creates standardized evidence files, result packages, and summary content.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Email Dispatch Connector" id="AC_EMAIL">
      <documentation>Sends standardized result emails and distributes the evidence package to the fixed distribution list.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="SharePoint Evidence Connector" id="AC_SHAREPOINT">
      <documentation>Publishes generated evidence files and outbound email records to SharePoint.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="DMS UI-Scraper" id="AC_DMS_SCRAPER">
      <documentation>Automates DMS upload, comment entry, and sign-off via screen scraping to satisfy the seminar requirement.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Exception Notification Module" id="AC_EXCEPTION">
      <documentation>Creates controlled exception cases and triggers targeted notifications instead of silent process failure.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Corporate Mail Service" id="AC_MAIL_SERVICE">
      <documentation>Provides the inbound and outbound mail capabilities used by the automation.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="SharePoint Repository" id="AC_SP_LIBRARY">
      <documentation>Target repository for evidence files and archived outbound messages.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="DMS Web Portal" id="AC_DMS_PORTAL">
      <documentation>Target system for compliant archival of the sent summary and evidence trail.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Report Type A XML File" id="DO_REPORT_A_XML">
      <documentation>Daily snapshot report covering the previous business day. Inbound XML file extracted from the ZIP package and consumed by the automated workflow. File naming convention: YYYYMMDD_ReportTypeA.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Report Type B XML File" id="DO_REPORT_B_XML">
      <documentation>Month-to-date cumulative report covering the current calendar month. Inbound XML file extracted from the ZIP package and consumed by the automated workflow. File naming convention: YYYYMMDD_ReportTypeB.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Validation Result Set" id="DO_VALIDATION_RESULT">
      <documentation>Structured output produced by the rule evaluator for each report type. Contains the primary violation marker status and the outcome of the four secondary threshold column checks. Consumed by the evidence generator and the exception notification module to determine downstream action.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Evidence Package" id="DO_EVIDENCE_PACKAGE">
      <documentation>Standardized evidence file bundle produced for SharePoint publication and DMS archival.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Summary Email" id="DO_SUMMARY_EMAIL">
      <documentation>Standardized automated summary email sent to the distribution list.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Exception Case" id="DO_EXCEPTION_CASE">
      <documentation>Controlled exception payload used for governance, escalation, and review.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="DMS Archive Record" id="DO_DMS_RECORD">
      <documentation>Archived DMS day entry containing the uploaded mail record and final sign-off status.</documentation>
    </element>
  </folder>
  <folder name="Technology &amp; Physical" id="id-soll-folder-technology" type="technology">
    <element xsi:type="archimate:Node" name="Automation Server" id="ND_AUTOMATION">
      <documentation>Execution environment for the scheduled automation workload.</documentation>
    </element>
    <element xsi:type="archimate:Artifact" name="Automation Package" id="AR_AUTOMATION">
      <documentation>Deployed automation artifact containing the scheduler and Python orchestration code.</documentation>
    </element>
    <element xsi:type="archimate:Artifact" name="Connector Package" id="AR_CONNECTORS">
      <documentation>Deployed integration artifact containing mail and SharePoint adapters.</documentation>
    </element>
    <element xsi:type="archimate:Artifact" name="RPA Deployment Package" id="AR_RPA">
      <documentation>Deployed artifact containing the DMS UI automation scripts.</documentation>
    </element>
  </folder>
  <folder name="Motivation" id="id-soll-folder-motivation" type="motivation">
    <element xsi:type="archimate:Driver" name="Manual Effort Reduction" id="DRV_MANUAL_EFFORT">
      <documentation>Daily manual work and repetitive handling create pressure to automate the process.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Operational Control Risk" id="DRV_CONTROL_RISK">
      <documentation>Manual checks and forgotten archival steps create control and audit risk.</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Full Daily Automation" id="GOAL_FULL_AUTOMATION">
      <documentation>The standard daily process should complete without manual execution.</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Standardized Audit Trail" id="GOAL_AUDIT_TRAIL">
      <documentation>Evidence and archive outputs should be consistent, traceable, and repeatable.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Screen Scraping Requirement" id="REQ_DMS_SCRAPING">
      <documentation>The DMS upload and sign-off must be automated with a UI-scraping or RPA component.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Exception Governance Requirement" id="REQ_EXCEPTION_GOVERNANCE">
      <documentation>Exceptions must remain visible, reviewable, and controllable by the supervisor.</documentation>
    </element>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-soll-folder-implementation" type="implementation_migration"/>
  <folder name="Other" id="id-soll-folder-other" type="other"/>
  <folder name="Relations" id="id-soll-folder-relations" type="relations">
