      <bpmn:dataOutputAssociation id="DataOutputAssoc_SP2">
        <bpmn:targetRef>DataStore_SharePoint_SOLL</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Activity_0gv1cpp" name="Send Summary Email">
      <bpmn:incoming>Flow_1a75x48</bpmn:incoming>
      <bpmn:outgoing>Flow_08fuq5s</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_AutoSaveSP1" name="Save Evidence via API">
      <bpmn:incoming>Flow_15mmuok</bpmn:incoming>
      <bpmn:outgoing>Flow_SaveSP1_Email</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssoc_SP1">
        <bpmn:targetRef>DataStore_SharePoint_SOLL</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="DataStore_SharePoint_SOLL" name="SharePoint Evidence Repo" />
    <bpmn:serviceTask id="Activity_141bjdt" name="Generate Evidence File (Excel)">
      <bpmn:incoming>Flow_08grfbt</bpmn:incoming>
      <bpmn:outgoing>Flow_0npq6ee</bpmn:outgoing>
    </bpmn:serviceTask>
