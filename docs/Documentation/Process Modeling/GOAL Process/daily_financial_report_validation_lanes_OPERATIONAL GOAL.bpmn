<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_DailyFinancialReportValidation_SOLL" targetNamespace="http://example.com/bpmn/daily-financial-report-validation-soll" exporter="Camunda Modeler" exporterVersion="5.45.0">
  <bpmn:collaboration id="Collaboration_DailyFinancialReportValidation_SOLL">
    <bpmn:participant id="Participant_Process_SOLL" name="Automated Daily Report Processing (SOLL)" processRef="Process_DailyFinancialReportValidation_SOLL" />
    <bpmn:participant id="Participant_1gkvz67" name="Operations Supervisor" processRef="Process_1kh3osu" />
    <bpmn:participant id="Participant_1rlptk1" name="Email System (Black Box)" />
    <bpmn:messageFlow id="Flow_0fou98p" sourceRef="Task_GenerateException" targetRef="Task_SupervisorReview" />
    <bpmn:messageFlow id="Flow_1spzyza" sourceRef="Task_AutoSaveSP2" targetRef="Activity_1wf7vma" />
    <bpmn:messageFlow id="Flow_01c0m6k" sourceRef="Activity_0tmwaz1" targetRef="Activity_1hnxzx8" />
    <bpmn:messageFlow id="Flow_18lqjuo" name="Report A/B in Message Flow" sourceRef="Participant_1rlptk1" targetRef="StartEvent_EmailReceived" />
  </bpmn:collaboration>
  <bpmn:process id="Process_DailyFinancialReportValidation_SOLL" name="Daily Financial Report Validation SOLL" isExecutable="true">
    <bpmn:documentation>
      Fully automated target architecture (SOLL). RPA/Python parses the XML reports directly, applies the validation rules, and interacts with SharePoint and DMS via API. Human intervention (Operations Supervisor) is strictly limited to Exception Review &amp; Governance.
    </bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Main_SOLL">
      <bpmn:lane id="Lane_AutomationService" name="Automated Reporting Service (RPA/AI)">
        <bpmn:flowNodeRef>Task_AutoExtract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_0z9q0e8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoValidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_04ayc1v</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_0mehm57</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AutoExceptions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0gv1cpp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_141bjdt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1vcj43z</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1ckxm6w</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0gxphyk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1ujf0dr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0pygaxd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateException</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0tmwaz1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_EmailReceived</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SharePoint" name="SharePoint (API)">
        <bpmn:flowNodeRef>Task_AutoSaveSP2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoSaveSP1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DMS" name="DMS System (API / Scraper)" />
    </bpmn:laneSet>
    <bpmn:dataStoreReference id="DataStore_DMS_SOLL" name="DMS Archive Repo" />
    <bpmn:serviceTask id="Task_AutoExtract" name="Auto-extract XML attachments">
      <bpmn:incoming>Flow_0b20ovf</bpmn:incoming>
      <bpmn:outgoing>Flow_1fpvkyg</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_0z9q0e8">
      <bpmn:incoming>Flow_1fpvkyg</bpmn:incoming>
      <bpmn:outgoing>Flow_1stt29y</bpmn:outgoing>
      <bpmn:outgoing>Flow_03gmjzb</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_AutoValidate" name="Parse XML Report A">
      <bpmn:documentation>Bot parses XML directly in memory, checking DayViol and MonthViol thresholds without manual Excel rendering.</bpmn:documentation>
      <bpmn:incoming>Flow_1stt29y</bpmn:incoming>
      <bpmn:outgoing>Flow_1tocd4w</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_04ayc1v" name="Parse XML  Report B">
      <bpmn:documentation>Bot parses XML directly in memory, checking DayViol and MonthViol thresholds without manual Excel rendering.</bpmn:documentation>
      <bpmn:incoming>Flow_03gmjzb</bpmn:incoming>
      <bpmn:outgoing>Flow_1l9fngg</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AutoEmail" name="Draft Summary Email">
      <bpmn:incoming>Flow_SaveSP1_Email</bpmn:incoming>
      <bpmn:outgoing>Flow_1a75x48</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_0mehm57">
      <bpmn:incoming>Flow_0npq6ee</bpmn:incoming>
      <bpmn:incoming>Flow_11oo7g3</bpmn:incoming>
      <bpmn:outgoing>Flow_1pg4obp</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_AutoExceptions" name="Rule Violation detected?">
      <bpmn:incoming>Flow_1pg4obp</bpmn:incoming>
      <bpmn:outgoing>Flow_Exceptions_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_15mmuok</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_AutoSaveSP2" name="Save Sent Email to SharePoint">
