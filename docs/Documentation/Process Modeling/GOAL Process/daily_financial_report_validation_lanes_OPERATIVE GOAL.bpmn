    <bpmn:sequenceFlow id="Flow_1tocd4w" sourceRef="Task_AutoValidate" targetRef="Gateway_1ujf0dr" />
    <bpmn:sequenceFlow id="Flow_SaveSP1_Email" sourceRef="Task_AutoSaveSP1" targetRef="Task_AutoEmail" />
