    <bpmn:sequenceFlow id="Flow_ReportBParseFail" name="yes" sourceRef="Gateway_ReportBParsing" targetRef="Activity_ReportBErrorMsg" />
    <bpmn:sequenceFlow id="Flow_ReportBErrToLog" sourceRef="Activity_ReportBErrorMsg" targetRef="Activity_ReportBErrorLog" />
    <bpmn:sequenceFlow id="Flow_ToParseErrorBEnd" sourceRef="Activity_ReportBErrorLog" targetRef="EndEvent_ParseErrorB" />
    <bpmn:startEvent id="StartEvent_EmailReceived" name="Financial Report email received">
      <bpmn:outgoing>Flow_0b20ovf</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Email_SOLL" />
    </bpmn:startEvent>
  </bpmn:process>
  <bpmn:process id="Process_1kh3osu" isExecutable="false">
    <!-- Start Events for Supervisor pool (NEW) -->
    <bpmn:startEvent id="StartEvent_ParseError" name="Parsing Error Received">
      <bpmn:outgoing>Flow_StartToReviewParse</bpmn:outgoing>
