<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_DailyFinancialReportValidation_SOLL" targetNamespace="http://example.com/bpmn/daily-financial-report-validation-soll" exporter="Camunda Modeler" exporterVersion="5.45.0">
  <bpmn:collaboration id="Collaboration_DailyFinancialReportValidation_SOLL">
    <bpmn:participant id="Participant_Process_SOLL" name="Automated Daily Report Processing (SOLL)" processRef="Process_DailyFinancialReportValidation_SOLL" />
  </bpmn:collaboration>
  <bpmn:process id="Process_DailyFinancialReportValidation_SOLL" name="Daily Financial Report Validation SOLL" isExecutable="true">
    <bpmn:documentation>
      Fully automated target architecture (SOLL). RPA/Python parses the XML reports directly, applies the validation rules, and interacts with SharePoint and DMS via API. Human intervention (Operations Supervisor) is strictly limited to Exception Review &amp; Governance.
    </bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Main_SOLL">
      <bpmn:lane id="Lane_EmailSystem" name="Email System">
        <bpmn:flowNodeRef>StartEvent_EmailReceived</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AutomationService" name="Automated Reporting Service (RPA/AI)">
        <bpmn:flowNodeRef>Task_AutoExtract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_0z9q0e8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoValidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_04ayc1v</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateException</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0xake5j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_141bjdt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1vcj43z</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_0mehm57</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AutoExceptions</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supervisor" name="Operations Supervisor">
        <bpmn:flowNodeRef>Task_SupervisorReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Exception</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SharePoint" name="SharePoint (API)">
        <bpmn:flowNodeRef>Task_AutoSaveSP1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoSaveSP2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DMS" name="DMS System (API / Scraper)">
        <bpmn:flowNodeRef>Task_AutoArchiveDMS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_EmailReceived" name="Financial Report email received">
      <bpmn:outgoing>Flow_Start_Extract</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Email_SOLL" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Start_Extract" sourceRef="StartEvent_EmailReceived" targetRef="Task_AutoExtract" />
    <bpmn:serviceTask id="Task_AutoExtract" name="Auto-extract XML attachments">
      <bpmn:incoming>Flow_Start_Extract</bpmn:incoming>
      <bpmn:outgoing>Flow_1fpvkyg</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Exceptions_Yes" name="yes" sourceRef="Gateway_AutoExceptions" targetRef="Task_GenerateException" />
    <bpmn:dataStoreReference id="DataStore_DMS_SOLL" name="DMS Archive Repo" />
    <bpmn:parallelGateway id="Gateway_0z9q0e8">
      <bpmn:incoming>Flow_1fpvkyg</bpmn:incoming>
      <bpmn:outgoing>Flow_1stt29y</bpmn:outgoing>
      <bpmn:outgoing>Flow_03gmjzb</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_1fpvkyg" sourceRef="Task_AutoExtract" targetRef="Gateway_0z9q0e8" />
    <bpmn:sequenceFlow id="Flow_15mmuok" name="no" sourceRef="Gateway_AutoExceptions" targetRef="Task_AutoSaveSP1" />
    <bpmn:serviceTask id="Task_AutoValidate" name="Parse XML &#38; evaluate Report A rules">
      <bpmn:documentation>Bot parses XML directly in memory, checking DayViol and MonthViol thresholds without manual Excel rendering.</bpmn:documentation>
      <bpmn:incoming>Flow_1stt29y</bpmn:incoming>
      <bpmn:outgoing>Flow_1vpffjz</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_04ayc1v" name="Parse XML &#38; evaluate Report B rules">
      <bpmn:documentation>Bot parses XML directly in memory, checking DayViol and MonthViol thresholds without manual Excel rendering.</bpmn:documentation>
      <bpmn:incoming>Flow_03gmjzb</bpmn:incoming>
      <bpmn:outgoing>Flow_1l9fngg</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1stt29y" sourceRef="Gateway_0z9q0e8" targetRef="Task_AutoValidate" />
    <bpmn:sequenceFlow id="Flow_03gmjzb" sourceRef="Gateway_0z9q0e8" targetRef="Activity_04ayc1v" />
    <bpmn:sequenceFlow id="Flow_1pg4obp" sourceRef="Gateway_0mehm57" targetRef="Gateway_AutoExceptions" />
    <bpmn:serviceTask id="Task_GenerateException" name="Generate Exception Alert">
      <bpmn:incoming>Flow_Exceptions_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_GenEx_Review</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_SupervisorReview" name="Review Exception &#38; Execute Governance">
      <bpmn:incoming>Flow_GenEx_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_EndEx</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Exception" name="Exception Handled Manually">
      <bpmn:incoming>Flow_Review_EndEx</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_AutoSaveSP1" name="Save Evidence via API">
      <bpmn:incoming>Flow_15mmuok</bpmn:incoming>
      <bpmn:outgoing>Flow_SaveSP1_Email</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssoc_SP1">
        <bpmn:targetRef>DataStore_SharePoint_SOLL</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AutoEmail" name="Draft Summary Email">
      <bpmn:incoming>Flow_SaveSP1_Email</bpmn:incoming>
      <bpmn:outgoing>Flow_1a75x48</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AutoSaveSP2" name="Save Sent Email to SharePoint">
      <bpmn:incoming>Flow_1qjxmkd</bpmn:incoming>
      <bpmn:outgoing>Flow_SaveSP2_DMS</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssoc_SP2">
        <bpmn:targetRef>DataStore_SharePoint_SOLL</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AutoArchiveDMS" name="Archive Email &#38; Auto Sign-Off">
      <bpmn:incoming>Flow_SaveSP2_DMS</bpmn:incoming>
      <bpmn:outgoing>Flow_DMS_End</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssoc_DMS">
        <bpmn:targetRef>DataStore_DMS_SOLL</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Success" name="Automated Processing Completed">
      <bpmn:incoming>Flow_DMS_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DataStore_SharePoint_SOLL" name="SharePoint Evidence Repo" />
    <bpmn:serviceTask id="Activity_0xake5j" name="Send Summary Email">
      <bpmn:incoming>Flow_1a75x48</bpmn:incoming>
      <bpmn:outgoing>Flow_1qjxmkd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_GenEx_Review" sourceRef="Task_GenerateException" targetRef="Task_SupervisorReview" />
    <bpmn:sequenceFlow id="Flow_Review_EndEx" sourceRef="Task_SupervisorReview" targetRef="EndEvent_Exception" />
    <bpmn:sequenceFlow id="Flow_SaveSP1_Email" sourceRef="Task_AutoSaveSP1" targetRef="Task_AutoEmail" />
    <bpmn:sequenceFlow id="Flow_1a75x48" sourceRef="Task_AutoEmail" targetRef="Activity_0xake5j" />
    <bpmn:sequenceFlow id="Flow_1qjxmkd" sourceRef="Activity_0xake5j" targetRef="Task_AutoSaveSP2" />
    <bpmn:sequenceFlow id="Flow_SaveSP2_DMS" sourceRef="Task_AutoSaveSP2" targetRef="Task_AutoArchiveDMS" />
    <bpmn:sequenceFlow id="Flow_DMS_End" sourceRef="Task_AutoArchiveDMS" targetRef="EndEvent_Success" />
    <bpmn:serviceTask id="Activity_141bjdt" name="Generate Evidence File (Excel)">
      <bpmn:incoming>Flow_1vpffjz</bpmn:incoming>
      <bpmn:outgoing>Flow_0npq6ee</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_1vcj43z" name="Generate Evidence File (Excel)">
      <bpmn:incoming>Flow_1l9fngg</bpmn:incoming>
      <bpmn:outgoing>Flow_11oo7g3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1vpffjz" sourceRef="Task_AutoValidate" targetRef="Activity_141bjdt" />
    <bpmn:sequenceFlow id="Flow_1l9fngg" sourceRef="Activity_04ayc1v" targetRef="Activity_1vcj43z" />
    <bpmn:parallelGateway id="Gateway_0mehm57">
      <bpmn:incoming>Flow_0npq6ee</bpmn:incoming>
      <bpmn:incoming>Flow_11oo7g3</bpmn:incoming>
      <bpmn:outgoing>Flow_1pg4obp</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_0npq6ee" sourceRef="Activity_141bjdt" targetRef="Gateway_0mehm57" />
    <bpmn:sequenceFlow id="Flow_11oo7g3" sourceRef="Activity_1vcj43z" targetRef="Gateway_0mehm57" />
    <bpmn:exclusiveGateway id="Gateway_AutoExceptions" name="Rule Violation detected?">
      <bpmn:incoming>Flow_1pg4obp</bpmn:incoming>
      <bpmn:outgoing>Flow_Exceptions_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_15mmuok</bpmn:outgoing>
    </bpmn:exclusiveGateway>
  </bpmn:process>
