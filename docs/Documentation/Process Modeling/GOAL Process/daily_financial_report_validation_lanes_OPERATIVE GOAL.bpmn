<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_DailyFinancialReportValidation_SOLL" targetNamespace="http://example.com/bpmn/daily-financial-report-validation-soll" exporter="Camunda Modeler" exporterVersion="5.45.0">
  <bpmn:collaboration id="Collaboration_DailyFinancialReportValidation_SOLL">
    <bpmn:participant id="Participant_Process_SOLL" name="Automated Daily Report Processing (SOLL)" processRef="Process_DailyFinancialReportValidation_SOLL" />
    <bpmn:participant id="Participant_1gkvz67" name="Operations Supervisor" processRef="Process_1kh3osu" />
    <bpmn:participant id="Participant_1rlptk1" name="Email System (Black Box)" />
    <bpmn:messageFlow id="Flow_0fou98p" sourceRef="Task_GenerateException" targetRef="StartEvent_ExceptionAlert" />
    <bpmn:messageFlow id="Flow_1spzyza" sourceRef="Task_AutoSaveSP2" targetRef="StartEvent_EmailSaved" />
    <bpmn:messageFlow id="Flow_01c0m6k" sourceRef="Activity_0tmwaz1" targetRef="StartEvent_ParseError" />
    <bpmn:messageFlow id="Flow_18lqjuo" name="Report A/B in Message Flow" sourceRef="Participant_1rlptk1" targetRef="StartEvent_EmailReceived" />
    <bpmn:messageFlow id="Flow_MsgReportBError" sourceRef="Activity_ReportBErrorLog" targetRef="StartEvent_ReportBError" />
  </bpmn:collaboration>
  <bpmn:process id="Process_DailyFinancialReportValidation_SOLL" name="Daily Financial Report Validation SOLL" isExecutable="true">
    <bpmn:documentation>
      Fully automated target architecture (SOLL). RPA/Python parses the XML reports directly, applies the validation rules, and interacts with SharePoint via API. Human intervention (Operations Supervisor) is strictly limited to Exception Review &amp; Governance.
    </bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Main_SOLL">
      <bpmn:lane id="Lane_AutomationService" name="Automated Reporting Service (RPA/AI)">
        <bpmn:flowNodeRef>Task_AutoExtract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_0z9q0e8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoValidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_04ayc1v</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_0mehm57</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AutoExceptions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0gv1cpp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_141bjdt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1vcj43z</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1ckxm6w</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0gxphyk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1ujf0dr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0pygaxd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateException</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0tmwaz1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_EmailReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_HappyPath</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ExceptionSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ParseErrorA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReportBParsing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ReportBErrorMsg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ReportBErrorLog</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ParseErrorB</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SharePoint" name="SharePoint (API)">
        <bpmn:flowNodeRef>Task_AutoSaveSP2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoSaveSP1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="Task_AutoExtract" name="Auto-extract XML attachments">
      <bpmn:incoming>Flow_0b20ovf</bpmn:incoming>
      <bpmn:outgoing>Flow_1fpvkyg</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_0z9q0e8">
      <bpmn:incoming>Flow_1fpvkyg</bpmn:incoming>
      <bpmn:outgoing>Flow_1stt29y</bpmn:outgoing>
      <bpmn:outgoing>Flow_03gmjzb</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_AutoValidate" name="Parse XML Report A">
      <bpmn:documentation>Bot parses XML directly in memory, checking DayViol and MonthViol thresholds without manual Excel rendering.</bpmn:documentation>
      <bpmn:incoming>Flow_1stt29y</bpmn:incoming>
      <bpmn:outgoing>Flow_1tocd4w</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_04ayc1v" name="Parse XML  Report B">
      <bpmn:documentation>Bot parses XML directly in memory, checking DayViol and MonthViol thresholds without manual Excel rendering.</bpmn:documentation>
      <bpmn:incoming>Flow_03gmjzb</bpmn:incoming>
      <bpmn:outgoing>Flow_ReportBToGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AutoEmail" name="Draft Summary Email">
      <bpmn:incoming>Flow_SaveSP1_Email</bpmn:incoming>
      <bpmn:outgoing>Flow_1a75x48</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_0mehm57">
      <bpmn:incoming>Flow_0npq6ee</bpmn:incoming>
      <bpmn:incoming>Flow_11oo7g3</bpmn:incoming>
      <bpmn:outgoing>Flow_1pg4obp</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_AutoExceptions" name="Rule Violation detected?">
      <bpmn:incoming>Flow_1pg4obp</bpmn:incoming>
      <bpmn:outgoing>Flow_Exceptions_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_15mmuok</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_AutoSaveSP2" name="Save Sent Email to SharePoint">
      <bpmn:incoming>Flow_08fuq5s</bpmn:incoming>
      <bpmn:outgoing>Flow_ToHappyEnd</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssoc_SP2">
        <bpmn:targetRef>DataStore_SharePoint_SOLL</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Activity_0gv1cpp" name="Send Summary Email">
      <bpmn:incoming>Flow_1a75x48</bpmn:incoming>
      <bpmn:outgoing>Flow_08fuq5s</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_AutoSaveSP1" name="Save Evidence via API">
      <bpmn:incoming>Flow_15mmuok</bpmn:incoming>
      <bpmn:outgoing>Flow_SaveSP1_Email</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssoc_SP1">
        <bpmn:targetRef>DataStore_SharePoint_SOLL</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="DataStore_SharePoint_SOLL" name="SharePoint Evidence Repo" />
    <bpmn:serviceTask id="Activity_141bjdt" name="Generate Evidence File (Excel)">
      <bpmn:incoming>Flow_08grfbt</bpmn:incoming>
      <bpmn:outgoing>Flow_0npq6ee</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_1vcj43z" name="Generate Evidence File (Excel)">
      <bpmn:incoming>Flow_1fyeevp</bpmn:incoming>
      <bpmn:outgoing>Flow_11oo7g3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_1ckxm6w" name="Evaluate Report B rules">
      <bpmn:documentation>Bot parses XML directly in memory, checking DayViol and MonthViol thresholds without manual Excel rendering.</bpmn:documentation>
      <bpmn:incoming>Flow_ReportBParseOK</bpmn:incoming>
      <bpmn:outgoing>Flow_1fyeevp</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0gxphyk" name="Evaluate Report A rules">
      <bpmn:documentation>Bot parses XML directly in memory, checking DayViol and MonthViol thresholds without manual Excel rendering.</bpmn:documentation>
      <bpmn:incoming>Flow_06edhxy</bpmn:incoming>
      <bpmn:outgoing>Flow_08grfbt</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_1ujf0dr" name="Parsing A failed?">
      <bpmn:incoming>Flow_1tocd4w</bpmn:incoming>
      <bpmn:outgoing>Flow_0x3e5bu</bpmn:outgoing>
      <bpmn:outgoing>Flow_06edhxy</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_0pygaxd" name="Create Parsing Error Message">
      <bpmn:incoming>Flow_0x3e5bu</bpmn:incoming>
      <bpmn:outgoing>Flow_1br1w5g</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_GenerateException" name="Generate Exception Alert">
      <bpmn:incoming>Flow_Exceptions_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_ToExceptionEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0tmwaz1" name="Create Error Log File">
      <bpmn:incoming>Flow_1br1w5g</bpmn:incoming>
      <bpmn:outgoing>Flow_ToParseErrorAEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <!-- Report B Parsing Error Handling (NEW) -->
    <bpmn:exclusiveGateway id="Gateway_ReportBParsing" name="Parsing B failed?">
      <bpmn:incoming>Flow_ReportBToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ReportBParseOK</bpmn:outgoing>
      <bpmn:outgoing>Flow_ReportBParseFail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_ReportBErrorMsg" name="Create Parsing Error Message (B)">
      <bpmn:incoming>Flow_ReportBParseFail</bpmn:incoming>
      <bpmn:outgoing>Flow_ReportBErrToLog</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_ReportBErrorLog" name="Create Error Log File (B)">
      <bpmn:incoming>Flow_ReportBErrToLog</bpmn:incoming>
      <bpmn:outgoing>Flow_ToParseErrorBEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <!-- End Events for upper pool (NEW) -->
    <bpmn:endEvent id="EndEvent_HappyPath" name="Reports Processed Successfully">
      <bpmn:incoming>Flow_ToHappyEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_ExceptionSent" name="Exception Alert Sent">
      <bpmn:incoming>Flow_ToExceptionEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_ParseErrorA" name="Parsing Error A Reported">
      <bpmn:incoming>Flow_ToParseErrorAEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_ParseErrorB" name="Parsing Error B Reported">
      <bpmn:incoming>Flow_ToParseErrorBEnd</bpmn:incoming>
    </bpmn:endEvent>
    <!-- Existing sequence flows -->
    <bpmn:sequenceFlow id="Flow_1fpvkyg" sourceRef="Task_AutoExtract" targetRef="Gateway_0z9q0e8" />
