    <bpmn:sequenceFlow id="Flow_11oo7g3" sourceRef="Activity_1vcj43z" targetRef="Gateway_0mehm57" />
    <bpmn:sequenceFlow id="Flow_1pg4obp" sourceRef="Gateway_0mehm57" targetRef="Gateway_AutoExceptions" />
    <bpmn:sequenceFlow id="Flow_Exceptions_Yes" name="yes" sourceRef="Gateway_AutoExceptions" targetRef="Task_GenerateException" />
    <bpmn:sequenceFlow id="Flow_15mmuok" name="no" sourceRef="Gateway_AutoExceptions" targetRef="Task_AutoSaveSP1" />
    <bpmn:sequenceFlow id="Flow_08fuq5s" sourceRef="Activity_0gv1cpp" targetRef="Task_AutoSaveSP2" />
    <bpmn:sequenceFlow id="Flow_08grfbt" sourceRef="Activity_0gxphyk" targetRef="Activity_141bjdt" />
    <bpmn:sequenceFlow id="Flow_1fyeevp" sourceRef="Activity_1ckxm6w" targetRef="Activity_1vcj43z" />
    <bpmn:sequenceFlow id="Flow_06edhxy" name="no" sourceRef="Gateway_1ujf0dr" targetRef="Activity_0gxphyk" />
    <bpmn:sequenceFlow id="Flow_0x3e5bu" name="yes" sourceRef="Gateway_1ujf0dr" targetRef="Activity_0pygaxd" />
    <bpmn:sequenceFlow id="Flow_1br1w5g" sourceRef="Activity_0pygaxd" targetRef="Activity_0tmwaz1" />
    <bpmn:sequenceFlow id="Flow_0b20ovf" sourceRef="StartEvent_EmailReceived" targetRef="Task_AutoExtract" />
    <!-- New sequence flows for end events -->
    <bpmn:sequenceFlow id="Flow_ToHappyEnd" sourceRef="Task_AutoSaveSP2" targetRef="EndEvent_HappyPath" />
    <bpmn:sequenceFlow id="Flow_ToExceptionEnd" sourceRef="Task_GenerateException" targetRef="EndEvent_ExceptionSent" />
    <bpmn:sequenceFlow id="Flow_ToParseErrorAEnd" sourceRef="Activity_0tmwaz1" targetRef="EndEvent_ParseErrorA" />
